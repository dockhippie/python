FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:3bc741aa7a7d205d2072f9a9e27fc5013dfe4638aca7fbebd562eaad2474847f

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

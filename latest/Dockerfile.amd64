FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:d5685e65dc2115f14378965ccd7c870abfede1dc4d1351cbb9a566c91fe3bc3e

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

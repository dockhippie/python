FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:ea1feeff5badc52f4336db1dececa292f2d87e9f30d7457899ed33bb6bd3eab6

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

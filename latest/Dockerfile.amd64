FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:9587316c5950be778fea2c52812e1f680a89a2723fe6e6bf244ab752b61d5821

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

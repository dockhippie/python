FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:a5b5b5738198c9959ee9b97b58fa50c8bfd4b22ac562797c270a55aca384d0eb

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:8162fc609de64c04bd21b7a2e384f6246865938c53d5709e74c5d8a201ff7a98

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

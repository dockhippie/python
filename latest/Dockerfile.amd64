FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:521c63eb29b1cc282ec04e4286d00d4f6f71c190bca72fc5d2d4fd0c4df8bdf9

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

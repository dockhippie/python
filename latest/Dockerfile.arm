FROM ghcr.io/dockhippie/alpine:latest-arm@sha256:e9402cdc2d753b43018c5f982da7f11e47bf4cb05fac7ee583a564ab77d9c191

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

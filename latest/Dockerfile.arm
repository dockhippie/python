FROM ghcr.io/dockhippie/alpine:latest-arm@sha256:cffb33227061ee4c287b649f095fdef75c4d36670eff3ddb8b9908460c748a92

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

FROM ghcr.io/dockhippie/alpine:latest-arm@sha256:408d8223e9a156541e162ad29ccb4b91a86b62e0a1f9df66ccf55aacc0a6f25b

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

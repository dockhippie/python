FROM ghcr.io/dockhippie/alpine:latest-arm@sha256:0321460119fa8f5dc0f0c86a9fdd53ab95ebff5f8b6572eda7172a48e244e704

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

FROM ghcr.io/dockhippie/alpine:latest-arm@sha256:78388801599b77269a14eb042b5d183e91eca4913d2ab36bc1269becb4e1cb36

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

FROM ghcr.io/dockhippie/alpine:latest-arm@sha256:42170c9b33ecc912939abdb293b92592b7661e9f75c7b420a06e1a22e594d112

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

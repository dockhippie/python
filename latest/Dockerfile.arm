FROM ghcr.io/dockhippie/alpine:latest-arm@sha256:cf28f1c99c7942d0b14bac79e9c57b540cff3a4cde232a857531fcdfbfd0f198

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

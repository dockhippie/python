FROM ghcr.io/dockhippie/alpine:latest-arm@sha256:5dcda574e0b5f95953b96f92905896fcd82ed64386fb9020d63819a977662700

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

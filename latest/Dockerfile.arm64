FROM ghcr.io/dockhippie/alpine:latest-arm64@sha256:3da335cc3688949b68abb3b4c50e9dd737b92e8811291ced7966423cde426276

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

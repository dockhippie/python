FROM ghcr.io/dockhippie/alpine:latest-arm64@sha256:d8ff6b55d1d4ffe07bf9730caf91a6b2ae33bfcdc2fff3c6c0ba5418d7faf481

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

FROM ghcr.io/dockhippie/alpine:latest-arm64@sha256:fd6b64c28999f89881292745d098065d8114d2b1a05f1176d2ab60c87a96b78e

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

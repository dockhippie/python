FROM ghcr.io/dockhippie/alpine:latest-arm64@sha256:1492f5aaf2d87eddcaea16b7be2517d625863ab75320c765172d693f2305cb95

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

FROM ghcr.io/dockhippie/alpine:latest-arm64@sha256:54779ecd1011d1b6b3fd41754155d1de042d378f9fc53bc4ed276ae22f7ed572

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /

FROM ghcr.io/dockhippie/alpine:latest-arm64@sha256:42e9d6026db421728148551f4a047445739893f51ca8b854d9caa66e54f99f7e

WORKDIR /srv/app

RUN apk update && \
  apk upgrade && \
  apk add build-base openssl-dev libffi-dev git python3-dev python3 py3-pip py3-tox && \
  rm -rf /var/cache/apk/*

COPY ./overlay /
